rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ogni utente vede solo la propria scheda (che dice a quale famiglia appartiene)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /families/{fid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }

      allow read: if isMember();

      // Chi crea la famiglia ne è l'unico membro iniziale
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // I membri modificano liberamente; chi ha il codice può solo aggiungere se stesso
      allow update: if isMember() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
      );

      allow delete: if false;

      // Turni, impegni e attività: solo per i membri della famiglia
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }
    }
  }
}
